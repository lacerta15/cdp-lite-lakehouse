# CDP-Lite Lakehouse environment variables
# Copy to `.env` and edit before `docker compose up`

# --- Docker Hub (for tagging your custom images) ---
DOCKERHUB_USER=qmmp

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# --- Postgres (Hive Metastore backend) ---
POSTGRES_PASSWORD=hive

# --- Superset ---
# IMPORTANT: must be at least 32 characters
SUPERSET_SECRET_KEY=please-change-me-this-is-not-secure-at-all-32+
SUPERSET_ADMIN_PASSWORD=admin
